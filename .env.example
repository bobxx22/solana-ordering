# Copy to .env and adjust. .env is git-ignored; never put a private key here.

# mainnet-beta | devnet | localnet
CLUSTER=mainnet-beta

# Reads (slots, blocks, statuses, cluster info). Empty: Helius if HELIUS_API_KEY is set, else the rate-limited public endpoint.
RPC_URL=

# Where transactions are submitted; defaults to RPC_URL. A keyed endpoint (e.g. Helius) is more reliable.
SEND_RPC_URL=

# Or just a Helius key: used for RPC_URL when RPC_URL is empty
HELIUS_API_KEY=

# Wallet file in solana-keygen format (create with: node src/cli.ts keygen)
KEYPAIR=keys/payer.json

# Total spending limit in SOL; mainnet never goes above 0.05 regardless of this value.
SPEND_CAP_SOL=0.05

DATA_DIR=data
